# Salin file ini menjadi .env lalu ganti nilainya. File .env TIDAK di-commit ke GitHub.
DB_NAME=todo
DB_USER=todo
DB_PASSWORD=ganti-password-ini
DB_ROOT_PASSWORD=ganti-password-root-ini

# Port aplikasi di laptop/server (http://localhost:8080)
APP_PORT=8080

# Dipakai saat menarik image dari Docker Hub (server deployment)
DOCKERHUB_USERNAME=local
TAG=latest
APP_VERSION=dev
